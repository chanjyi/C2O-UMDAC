	partition evidence_matrix = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(TablesFolder & "evidence_matrix.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Selected = Table.SelectColumns(Promoted, {"id", "group", "rule", "value", "final_verdict", "causal_status", "out_of_sample", "verdict_note"}, MissingField.UseNull),
				    Indexed = Table.AddIndexColumn(Selected, "idx", 1, 1, Int64.Type),
				    Grouped = Table.AddColumn(Indexed, "group_order", each List.PositionOf({"Currency", "Amount", "Business/consumer", "Routing", "Duration", "FX", "Anomalies", "Accounts", "Details"}, [group]), Int64.Type),
				    Ordered = Table.AddColumn(Grouped, "rule_order", each [group_order] * 1000 + [idx], Int64.Type),
				    Typed = Table.TransformColumnTypes(Ordered, {{"id", type text}, {"group", type text}, {"rule", type text}, {"value", type text}, {"final_verdict", type text}, {"causal_status", type text}, {"out_of_sample", type text}, {"verdict_note", type text}, {"rule_order", Int64.Type}, {"group_order", Int64.Type}}, "en-US"),
				    Final = Table.SelectColumns(Typed, {"id", "group", "rule", "value", "final_verdict", "causal_status", "out_of_sample", "verdict_note", "rule_order", "group_order"})
				in
				    Final

	annotation PBI_ResultType = Table

