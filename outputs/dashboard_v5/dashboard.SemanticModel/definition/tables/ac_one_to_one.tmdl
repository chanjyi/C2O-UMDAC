table ac_one_to_one
	lineageTag: 8fccce1e-7fee-7b7a-ea33-f2c9784aa3a6

	column role
		dataType: string
		lineageTag: 2eb2c06a-7cc8-709b-1429-eb218e30f93d
		summarizeBy: none
