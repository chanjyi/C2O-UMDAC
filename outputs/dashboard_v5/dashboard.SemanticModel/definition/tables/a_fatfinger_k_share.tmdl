	partition a_fatfinger_k_share = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(TablesFolder & "a_fatfinger_k_share.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Unpivoted = Table.UnpivotOtherColumns(Promoted, {"k"}, "payments", "share"),
				    Named = Table.TransformColumns(Unpivoted, {{"k", each Number.Round(Number.FromText(_, "en-US")), Int64.Type}, {"payments", each if _ = "fat_finger" then "Fat-finger payments" else "Normal payments", type text}}),
				    Typed = Table.TransformColumnTypes(Named, {{"k", Int64.Type}, {"payments", type text}, {"share", type number}}, "en-US"),
				    Final = Table.SelectColumns(Typed, {"k", "payments", "share"})
				in
				    Final

	annotation PBI_ResultType = Table

