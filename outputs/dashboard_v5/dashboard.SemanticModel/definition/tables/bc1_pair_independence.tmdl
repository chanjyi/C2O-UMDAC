	partition bc1_pair_independence = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(TablesFolder & "bc1_pair_independence.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Renamed = Table.RenameColumns(Promoted, {{Table.ColumnNames(Promoted){0}, "pair"}, {"observed_%", "o"}, {"independent_%", "i"}}),
				    Scaled = Table.AddColumn(Table.AddColumn(Renamed, "observed", each Number.FromText([o], "en-US") / 100, type number), "if_independent", each Number.FromText([i], "en-US") / 100, type number),
				    Clean = Table.RemoveColumns(Scaled, {"o", "i"}),
				    Ordered = Table.AddColumn(Clean, "pair_order", each List.PositionOf({"C2C", "C2B", "B2C", "B2B"}, [pair]), Int64.Type),
				    Typed = Table.TransformColumnTypes(Ordered, {{"pair", type text}, {"observed", type number}, {"if_independent", type number}, {"pair_order", Int64.Type}}, "en-US"),
				    Final = Table.SelectColumns(Typed, {"pair", "observed", "if_independent", "pair_order"})
				in
				    Final

	annotation PBI_ResultType = Table

