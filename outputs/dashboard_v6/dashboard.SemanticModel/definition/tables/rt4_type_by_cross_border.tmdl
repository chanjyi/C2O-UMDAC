	partition rt4_type_by_cross_border = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(TablesFolder & "rt4_type_by_cross_border.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Labelled = Table.TransformColumns(Promoted, {{"grp", each if Text.Lower(_) = "true" then "Cross-border" else if Text.Lower(_) = "false" then "Domestic" else _, type text}}),
				    NumN = Table.TransformColumnTypes(Labelled, {{"n", Int64.Type}}, "en-US"),
				    Unpivoted = Table.UnpivotOtherColumns(NumN, {"grp", "n"}, "TRANSACTION_TYPE_CODE", "pct"),
				    Typed = Table.TransformColumnTypes(Unpivoted, {{"grp", type text}, {"n", Int64.Type}, {"TRANSACTION_TYPE_CODE", type text}, {"pct", type number}}, "en-US"),
				    Final = Table.SelectColumns(Typed, {"grp", "n", "TRANSACTION_TYPE_CODE", "pct"})
				in
				    Final

	annotation PBI_ResultType = Table

