	partition amt3_country_base_amount = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(TablesFolder & "amt3_country_base_amount.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Selected = Table.SelectColumns(Promoted, {"o_cc", "N", "typical_C2C_usd"}, MissingField.UseNull),
				    Num = Table.TransformColumnTypes(Selected, {{"typical_C2C_usd", type number}}, "en-US"),
				    Sorted = Table.Sort(Num, {{"typical_C2C_usd", Order.Descending}}),
				    Ends = Table.Combine({Table.AddColumn(Table.FirstN(Sorted, 7), "band", each "Highest 7", type text), Table.AddColumn(Table.LastN(Sorted, 7), "band", each "Lowest 7", type text)}),
				    Typed = Table.TransformColumnTypes(Ends, {{"o_cc", type text}, {"N", Int64.Type}, {"typical_C2C_usd", type number}, {"band", type text}}, "en-US"),
				    Final = Table.SelectColumns(Typed, {"o_cc", "N", "typical_C2C_usd", "band"})
				in
				    Final

	annotation PBI_ResultType = Table

