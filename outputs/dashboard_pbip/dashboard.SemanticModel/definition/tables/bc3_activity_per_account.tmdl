	partition bc3_activity_per_account = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(TablesFolder & "bc3_activity_per_account.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Named = Table.TransformColumns(Table.RenameColumns(Promoted, {{"t", "sender"}}), {{"sender", each if _ = "B" then "Business sender accounts" else "Consumer sender accounts", type text}}),
				    Typed = Table.TransformColumnTypes(Named, {{"sender", type text}, {"accounts", Int64.Type}, {"payments", Int64.Type}, {"per_account", type number}}, "en-US"),
				    Final = Table.SelectColumns(Typed, {"sender", "accounts", "payments", "per_account"})
				in
				    Final

	annotation PBI_ResultType = Table

