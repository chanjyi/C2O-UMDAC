	partition amt2_business_multiplier = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(TablesFolder & "amt2_business_multiplier.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Ordered = Table.AddColumn(Promoted, "pair_order", each List.PositionOf({"C2C", "C2B", "B2C", "B2B"}, [pair]), Int64.Type),
				    Typed = Table.TransformColumnTypes(Ordered, {{"pair", type text}, {"observed_x_vs_C2C", type number}, {"model_x", type number}, {"pair_order", Int64.Type}}, "en-US"),
