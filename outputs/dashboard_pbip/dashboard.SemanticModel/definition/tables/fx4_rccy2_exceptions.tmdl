	partition fx4_rccy2_exceptions = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(TablesFolder & "fx4_rccy2_exceptions.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Labelled = Table.TransformColumns(Promoted, {{"endpoints_match", each if Text.Lower(_) = "true" then "Path ends at the ordering / beneficiary BIC" else "Path starts or ends at another bank", type text}}),
				    Typed = Table.TransformColumnTypes(Labelled, {{"endpoints_match", type text}, {"n", Int64.Type}, {"acc_rccy2_ordering_beneficiary", type number}, {"acc_path_banks", type number}}, "en-US"),
				    Final = Table.SelectColumns(Typed, {"endpoints_match", "n", "acc_rccy2_ordering_beneficiary", "acc_path_banks"})
				in
				    Final

	annotation PBI_ResultType = Table

