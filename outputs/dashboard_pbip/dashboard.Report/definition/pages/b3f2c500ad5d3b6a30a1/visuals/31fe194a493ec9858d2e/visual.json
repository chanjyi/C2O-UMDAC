           "fontWeight": "bold",
           "fontSize": "11pt"
          }
         },
         {
          "value": "The path starts at the ordering BIC and ends at the beneficiary BIC in ~95% of rows (start 95.02%; end 95.01%)",
          "textStyle": {
           "fontSize": "11pt"
          }
         },
         {
          "value": "   [Strong]",
          "textStyle": {
           "fontSize": "11pt",
