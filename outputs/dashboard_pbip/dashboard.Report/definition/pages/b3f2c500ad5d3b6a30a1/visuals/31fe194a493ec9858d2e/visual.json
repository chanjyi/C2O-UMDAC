          "value": "Routing: hop count is geometric and independent of who pays whom",
          "textStyle": {
           "fontWeight": "bold",
           "fontSize": "18pt"
          }
         }
        ]
       },
       {
        "textRuns": [
         {
          "value": "R-RT1 / R-RT3   ",
          "textStyle": {
           "fontWeight": "bold",
           "fontSize": "11pt"
          }
         },
         {
          "value": "Direct payments involve exactly 2 banks, Indirect and Covered 3 or more; the participant count = BICs on the path",
          "textStyle": {
           "fontSize": "11pt"
          }
         },
         {
          "value": "   [Confirmed]",
          "textStyle": {
