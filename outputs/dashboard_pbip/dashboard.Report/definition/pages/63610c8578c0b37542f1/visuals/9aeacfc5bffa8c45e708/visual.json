            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Accounts and party details: format rules of the generator",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "18pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "AC1 / AC2   ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": "IBAN is used for every account of a bank country or for none (76 all-IBAN, 153 none, 0 mixed); non-IBAN numbers that contain a currency code use the local currency",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": "   [Confirmed]",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontStyle": "italic",
                      "color": "#605E5C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "AC3   ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": "Each sender account number belongs to one bank and one party type; some receiver numbers recur under several banks, so accounts are keyed by (BIC8, account) (multi-BIC: sender 0.00%, receiver 2.38%; multi-type 0.00%)",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": "   [Strong]",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontStyle": "italic",
                      "color": "#605E5C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "D1 / D4   ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": "Details lines are at most 35 characters (SWIFT MT); the sender address country = sender bank country",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": "   [Confirmed]",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontStyle": "italic",
                      "color": "#605E5C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "D2 / D3   ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": "Numbered and BIC-line formats never occur together (0.000% both); 80% are free text. Business parties get company-name tokens, consumers person-name tokens",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": "   [D2 Confirmed · D3 Partial]",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontStyle": "italic",
                      "color": "#605E5C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "D5   ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": "No detectable difference in the trailing filler line between any anomaly type and normal payments (gaps up to ~3 points cannot be excluded)",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": "   [Approximate]",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontStyle": "italic",
                      "color": "#605E5C"
                    }
